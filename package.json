{
  "name": "taint-tracked-tool-broker",
  "version": "0.2.0",
  "description": "Provenance labeling for agent inputs, enforced at the tool-call boundary. Blocks untrusted data from reaching shell, filesystem, and network sinks. Ships with an injection corpus and a published list of known gaps.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaVey/Taint-Tracked-Tool-Broker.git"
  },
  "bugs": {
    "url": "https://github.com/NovaVey/Taint-Tracked-Tool-Broker/issues"
  },
  "homepage": "https://github.com/NovaVey/Taint-Tracked-Tool-Broker#readme",
  "keywords": [
    "llm",
    "agent",
    "agentic",
    "tool-calling",
    "prompt-injection",
    "taint-tracking",
    "security",
    "ai-safety",
    "mcp",
    "sandboxing"
  ],
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "DESIGN.md",
    "GAPS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "corpus": "tsx corpus/run-corpus.ts",
    "example": "tsx examples/basic-usage.ts",
    "example:mcp": "tsx examples/mcp-integration.ts",
    "example:mcp-sdk": "tsx examples/mcp-sdk-integration.ts",
    "example:tool-loop": "tsx examples/anthropic-tool-loop.ts",
    "example:langchain": "tsx examples/langchain-integration.ts",
    "example:vercel-ai": "tsx examples/vercel-ai-sdk-integration.ts",
    "example:openai-agents": "tsx examples/openai-agents-sdk-integration.ts",
    "bench": "tsx bench/args-clone.ts",
    "bench:minhash": "tsx bench/minhash-sketch-tradeoff.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"corpus/**/*.ts\" \"examples/**/*.ts\" \"bench/**/*.ts\" \"*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"corpus/**/*.ts\" \"examples/**/*.ts\" \"bench/**/*.ts\" \"*.{js,ts}\""
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
